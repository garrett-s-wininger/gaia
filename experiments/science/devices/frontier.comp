#version 450
// GPU-ready bounded frontier propagation. This source alone is not GPU evidence.
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Edges { uvec2 edges[]; };
layout(std430,binding=1) readonly buffer Frontier { uint frontier[]; };
layout(std430,binding=2) buffer Next { uint next[]; };
layout(push_constant) uniform Bounds { uint edge_count; uint node_count; } bounds;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=bounds.edge_count)return;
    uvec2 edge=edges[i];
    if(edge.x>=bounds.node_count || edge.y>=bounds.node_count)return;
    if(frontier[edge.x]!=0)atomicOr(next[edge.y],1);
}
